{
  "name": "my-money",
  "version": "0.20.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Self-hosted, single-user personal finance tracker.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4000",
    "worker": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs src/worker/index.ts",
    "worker:once": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs src/worker/run-once.ts",
    "check": "biome check && tsc --noEmit",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "perf:dashboard": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/dashboard-perf.ts",
    "seed:demo": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/seed-demo.ts",
    "parity:networth": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/networth-parity.ts",
    "parity:figures": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/figures-parity.ts",
    "plaid:ping": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/plaid-ping.ts",
    "plaid:set-webhook-url": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/plaid-set-webhook-url.ts",
    "plaid:rotate-key": "node --env-file=.env.local --import tsx --import ./scripts/loaders/register.mjs scripts/rotate-encryption.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@node-rs/argon2": "2.0.2",
    "bullmq": "5.34.10",
    "decimal.js": "10.4.3",
    "drizzle-orm": "0.38.3",
    "ioredis": "5.4.2",
    "iron-session": "8.0.4",
    "jose": "^6.2.3",
    "next": "15.5.19",
    "nodemailer": "^8.0.10",
    "plaid": "^42.2.0",
    "postgres": "3.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-plaid-link": "^4.1.1",
    "recharts": "3.8.1",
    "yahoo-finance2": "2.13.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.49.1",
    "@tailwindcss/postcss": "4.1.7",
    "@types/node": "22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "2.1.8",
    "drizzle-kit": "0.30.1",
    "fast-check": "^4.8.0",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
