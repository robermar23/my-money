{
  "name": "my-money",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, single-user personal finance tracker.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4000",
    "worker": "node --env-file=.env.local --import tsx src/worker/index.ts",
    "worker:once": "node --env-file=.env.local --import tsx src/worker/run-once.ts",
    "check": "biome check && tsc --noEmit",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "bullmq": "5.34.10",
    "decimal.js": "10.4.3",
    "drizzle-orm": "0.38.3",
    "ioredis": "5.4.2",
    "iron-session": "8.0.4",
    "next": "15.1.3",
    "postgres": "3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "yahoo-finance2": "2.13.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.49.1",
    "@tailwindcss/postcss": "4.1.7",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "drizzle-kit": "0.30.1",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
