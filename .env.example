# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — NEVER commit real secrets.
#
# Per ADR-002 + CLAUDE.md §Secrets:
#   - All secrets via env vars
#   - MONEY_ENCRYPTION_KEY rotation = bricked Plaid tokens (Phase 4). Back it up.
#   - SESSION_SECRET rotation = forced re-login for the single user. Acceptable.

# ── Database (matches docker/compose.yaml defaults) ─────────────────────────
POSTGRES_USER=money
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=money
# DATABASE_URL is what the app + drizzle-kit consume.
DATABASE_URL=postgres://money:dev_password_change_me@127.0.0.1:5433/money

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6380

# ── Auth (per ADR-004: iron-session + argon2id) ─────────────────────────────
# SESSION_SECRET: 32+ random bytes, base64 or hex. Used by iron-session to
# encrypt the session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace_me_with_32_plus_random_bytes_min_length_32

# ── Encryption-at-rest for Plaid access tokens (Phase 4) ────────────────────
# 32 raw bytes, hex-encoded (64 hex chars). Used by AES-256-GCM.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# LOSING THIS KEY MAKES ALL ENCRYPTED PLAID TOKENS UNREADABLE.
MONEY_ENCRYPTION_KEY=replace_me_with_64_hex_chars_for_a_32_byte_aes_256_key

# ── Market data (Phase 2) ───────────────────────────────────────────────────
# Alpha Vantage free API key for physical-metal spot prices (XAU/USD).
# Get one at: https://www.alphavantage.co/support/#api-key
# Free tier = 25 requests/day, plenty for daily snapshots of a few metal symbols.
# Yahoo Finance (stocks) and CoinGecko (crypto) need NO key.
ALPHAVANTAGE_API_KEY=replace_me_with_a_free_alpha_vantage_key

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
