# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — NEVER commit real secrets.
#
# Per ADR-002 + CLAUDE.md §Secrets:
#   - All secrets via env vars
#   - MONEY_ENCRYPTION_KEY rotation = bricked Plaid tokens (Phase 4). Back it up.
#   - SESSION_SECRET rotation = forced re-login for the single user. Acceptable.

# ── Database (matches docker/compose.yaml defaults) ─────────────────────────
POSTGRES_USER=money
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=money
# DATABASE_URL is what the app + drizzle-kit consume.
DATABASE_URL=postgres://money:dev_password_change_me@127.0.0.1:5433/money

# Separate database for the Vitest suite. Tests TRUNCATE shared tables to
# achieve isolation, so they must NOT point at the dev DB. vitest.setup.ts
# refuses to run if this isn't set to a "test"-named database.
POSTGRES_TEST_DB=money_test
TEST_DATABASE_URL=postgres://money:dev_password_change_me@127.0.0.1:5434/money_test

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6380

# ── Auth (per ADR-004: iron-session + argon2id) ─────────────────────────────
# SESSION_SECRET: 32+ random bytes, base64 or hex. Used by iron-session to
# encrypt the session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace_me_with_32_plus_random_bytes_min_length_32

# Mark the session cookie `Secure` (HTTPS-only). Leave `false` for LAN access
# over plain HTTP (http://<host>:4000) — a Secure cookie is dropped by browsers
# over http, which breaks login (the password is re-prompted on every page). Set
# `true` only if you reach the app exclusively over HTTPS (e.g. the Cloudflare
# tunnel). Dev (`pnpm dev`, http://127.0.0.1:4000) wants it off too.
SESSION_COOKIE_SECURE=false

# ── Encryption-at-rest for Plaid access tokens (Phase 4, ADR-009) ───────────
# 32 raw bytes, base64-encoded (44 chars including trailing '='). Used by
# AES-256-GCM in src/lib/crypto/aead.ts. Validated at module load — a missing
# or short key crashes the process at boot, not at first encrypt.
# Generate with:
#   openssl rand -base64 32
# or:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# LOSING THIS KEY MAKES ALL ENCRYPTED PLAID TOKENS UNREADABLE. See
# docs/CRYPTO_ROTATION.md (P4-37) for the rotation runbook.
MONEY_ENCRYPTION_KEY=replace_me_with_32_random_bytes_base64_encoded_yyyyy=

# ── Plaid (Phase 4, ADR-008) ────────────────────────────────────────────────
# Sandbox is free + unlimited; Production has 100 free Items then ~$0.30/mo.
# Get credentials from https://dashboard.plaid.com → Team Settings → Keys.
# NEVER prefix with NEXT_PUBLIC_* — these must not reach the browser.
PLAID_CLIENT_ID=replace_me_with_plaid_client_id
PLAID_SECRET=replace_me_with_plaid_sandbox_or_production_secret
# 'sandbox' for development, 'production' once cutover is complete.
PLAID_ENV=sandbox
# Public HTTPS URL Plaid POSTs webhooks to. Set after P4-29 stands up
# cloudflared. Empty/unset is fine during local dev — Link works without it,
# and individual Items can have their webhook URL updated later via
# /item/webhook/update (see scripts/plaid-set-webhook-url.ts, P4-30).
PLAID_WEBHOOK_URL=

# ── Cloudflare Tunnel (Phase 4, ADR-010 + P4-29) ────────────────────────────
# Token used by the `cloudflared` container in docker/compose.yaml (prod
# profile) to dial Cloudflare's edge. Generate at:
#   https://one.dash.cloudflare.com → Networks → Tunnels → Create a tunnel
# After the tunnel exists, add a Public Hostname route:
#   your.domain.com  →  HTTP  →  app:4000
# See docs/DEPLOY.md for the full ritual. Empty/unset in dev — the prod
# compose profile refuses to start without it.
CLOUDFLARED_TOKEN=

# ── Backups (Phase 6, ADR-014) ──────────────────────────────────────────────
# Nightly `pg_dump | age` runs in the worker (04:00) and writes an encrypted
# dump to BACKUP_DIR. Off-host replication of that directory is YOUR job.
#
# BACKUP_AGE_RECIPIENT is an age PUBLIC key (`age1...`) — it is NOT a secret and
# is safe to keep here. Generate a keypair with:
#   age-keygen -o money-backup.key
# The file's "# public key:" line is the recipient below. The PRIVATE key
# (the file's `AGE-SECRET-KEY-...` line) is what decrypts a restore — keep it
# OFF this server (password manager / paper / a second machine). A server
# compromise must not be able to decrypt your backup history. Backup is disabled
# (the job skips) until a recipient is set.
BACKUP_AGE_RECIPIENT=
# Directory the encrypted dumps land in (a docker volume mounted into worker).
BACKUP_DIR=/backups
# Local retention; older *.dump.age files are pruned after a successful write.
# Off-host retention is your own policy.
BACKUP_RETAIN_DAYS=14

# Beancount export (Phase 6, ADR-016): a nightly, one-way, plain-text mirror of
# the DB written to this directory (a docker volume in prod). Readable in `less`
# forever — the longevity hedge. It is NOT a secret, but it IS plaintext
# financial data, so keep the directory private and replicate it off-host like
# the backups. The export is OPT-IN: leave this empty in dev and the job skips;
# the prod compose sets it to /exports.
BEANCOUNT_DIR=

# ── Anomaly alerts (Phase 6, ADR-015) ───────────────────────────────────────
# Nightly detection (05:00) writes anomalies to the `alerts` table, surfaced at
# /alerts. Thresholds (all optional — defaults shown):
ALERT_LARGE_TXN_USD=2000     # flag any single transaction larger than this
ALERT_BALANCE_DROP_PCT=25    # flag an account balance dropping more than this %
ALERT_STALE_DAYS=3           # flag snapshots/prices that stop updating for N days
# ALERT_CURRENCY=USD         # base currency for threshold comparisons
#
# Email is OPTIONAL and NOTIFICATION-ONLY: it carries a count + a sign-in link
# and ZERO financial data (no amounts/accounts/merchants) — the figures live only
# in the authenticated /alerts page. Transport is YOUR SMTP server (self-hosted
# or your mail provider); we ship no default relay. Leave SMTP_URL empty to use
# the in-app /alerts page as the only channel.
#   SMTP_URL=smtp://user:pass@mail.example.com:587
SMTP_URL=
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=         # defaults to ALERT_EMAIL_TO
# APP_BASE_URL=https://your-host  # used to build the /alerts link in the email
APP_BASE_URL=

# ── Market data (Phase 2) ───────────────────────────────────────────────────
# All sources are key-free:
#   - Yahoo Finance: equities AND physical metals (via front-month COMEX
#     futures — GC=F gold, SI=F silver, PL=F platinum, PA=F palladium;
#     tracks spot within a fraction of a percent)
#   - CoinGecko: crypto
# Alpha Vantage was removed when AV dropped metals from its free tier in 2026.

# ── App image (prod profile only; docker/compose.yaml) ──────────────────────
# Which image `app` and `worker` run. Defaults: the published robermar2/my-money
# at `latest`. Recommended: pin MONEY_IMAGE_TAG to a release from CHANGELOG.md
# (e.g. 0.19.0), so an upgrade happens only when you change it, after reading
# that release's Migrations line (docs/DEPLOY.md §Updates). To run an image you
# built from source, set both, e.g. my-money + local (docs/DEPLOY.md
# §Prerequisites, "Path B").
# MONEY_IMAGE_REPO=robermar2/my-money
# MONEY_IMAGE_TAG=latest

# ── Automatic migration (prod profile only; OFF by default) ─────────────────
# "true" makes the app apply pending database migrations every time it starts.
# Read this before turning it on: it changes the schema of your financial
# database unattended, and it takes NO backup first. A failed migration rolls
# back, but the app then stays down in a restart loop until you step in. The
# recommended path is explicit: back up, then `scripts/prod.sh migrate`, then
# restart (docs/DEPLOY.md §Updates). Settings → Instance warns while it is on.
# MONEY_AUTO_MIGRATE=false

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
